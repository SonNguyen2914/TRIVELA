# --- Mode ---
DEMO_MODE=true

# --- Kalshi (only needed when DEMO_MODE=false) ---
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# --- Archive database (WC26 plane: SQLite default) ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/kalshi

# --- LIVE plane (MLS) — dormant when unset. Any postgres:// or
# postgresql:// scheme is normalized to postgresql+psycopg:// (psycopg 3).
# LIVE_DATABASE_URL=postgresql://user:pass@host:5432/live

# --- Operating modes (fail-safe parsed: unknown values pick the safer
# mode). Real-money and auto-execution have NO enabled code paths.
COMPETITION=mls-2026
MLS_SHADOW_ENABLED=true
REAL_MONEY_SIGNALS_ENABLED=false
AUTO_EXECUTION_ENABLED=false

# --- Engine ---
N_SIMULATIONS=10000
PREDICTION_CACHE_TTL_SECONDS=300
HOURLY_PREDICTION_WINDOW_HOURS=6
FINAL_LOCK_MINUTES=10

# --- Filters ---
MIN_EDGE=0.05
MIN_CONFIDENCE=0.45
MIN_VOLUME_24H=10000

# --- Alerts (Discord two-channel split + secret ntfy topic) ---
DISCORD_ACTION_WEBHOOK_URL=
DISCORD_DETAIL_WEBHOOK_URL=
NTFY_TOPIC=

# --- Kalshi market hunter (observational scanner; shadow mode) ---
# Always-on OBSERVATIONAL scan of Kalshi's soccer GAME-series. Records
# findings + a per-cycle heartbeat; never places, sizes, or recommends
# an order. NOTE: HUNTER_ENABLED defaults true, so hunter_finding /
# hunter_cycle writes begin at first deploy. Every numeric bound below
# must be > 0 — config fails fast at import otherwise.
HUNTER_ENABLED=true
HUNTER_POLL_MINUTES=10
# Roster re-discovery cadence; between discoveries only recently-active
# series are scanned, so a series going active is seen with <= this lag.
HUNTER_DISCOVERY_MINUTES=360
# Optional explicit roster override (comma-separated series tickers);
# empty = live discovery (tags=Soccer, ticker ends GAME).
HUNTER_SERIES=
HUNTER_SERIES_SKIP=KXWCGOALEVERYGAME,KXWCTEAMSINGAME,KXKXECULPGAME
HUNTER_WIDE_SPREAD_DOLLARS=0.10
HUNTER_THIN_BOOK_SIZE=5
HUNTER_OVERREACTION_MIN_MOVE_DOLLARS=0.15
HUNTER_ALERT_MIN_MARGIN_DOLLARS=0.01
HUNTER_ALERT_MAX_PER_HOUR=4
HUNTER_MODEL_EDGE_MIN=0.03

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://namson.dev

# --- Bet-timing (ripeness) alerts ---
ODDS_POLL_SECONDS=30
RIPENESS_ALERT_THRESHOLD=75
RIPENESS_MIN_READINGS=10
ALERT_COOLDOWN_MINUTES=30

# Post-tournament lockdown: fail-closed EVERYWHERE by default (V9 eval
# F9.9 — the example must not ship a value that reopens writes when copied
# to prod). Set PUBLIC_READ_ONLY=false explicitly for LOCAL DEV only.
PUBLIC_READ_ONLY=true
ADMIN_TOKEN=

# --- Journal: interactive-session capability (journal-P0-G) ---
# The action channel reaches the person whose friend places REAL bets.
# ADMIN_TOKEN authenticates a request; it does not establish that a human
# session is speaking. Dispatch therefore needs a short-lived capability
# minted by a challenge/response handshake, and this is the SECOND factor
# that mints it. It must DIFFER from ADMIN_TOKEN — equal collapses two
# factors into one and the handshake refuses that configuration.
#
# Unset (the shipped default) means no session can be opened, so the
# relay cannot dispatch at all. That is the fail-closed state: set it
# only where the broadcast relay is actually wanted.
JOURNAL_SESSION_SECRET=
JOURNAL_SESSION_TTL_SECONDS=3600
JOURNAL_CHALLENGE_TTL_SECONDS=120

# --- Journal: quote capture-age ceilings (journal-P0-H) ---
# Kalshi publishes no quote timestamp, so our capture clock is the only
# evidence of when a book was observed. A quote older than these ceilings
# cannot become "the book at the time": at record time it is refused as
# the price basis and the refusal is classified on the row, at fill time
# it is refused outright.
JOURNAL_QUOTE_MAX_AGE_SECONDS=900
JOURNAL_FILL_QUOTE_MAX_AGE_SECONDS=300
# Clock-skew tolerance on operator/exchange timestamps. Slightly ahead of
# the server clock is skew; minutes ahead is a data-entry error.
JOURNAL_FUTURE_TOLERANCE_SECONDS=60
