      "epl-2026": {
        "k24_carried": 0.0334,
        "k6": 0.047,
        "gain": 0.0136
      },
      "liga-mx-2026": {
        "k24_carried": 0.0229,
        "k6": 0.0323,
        "gain": 0.0094
      },
      "la-liga-2026": {
        "k24_carried": 0.0333,
        "k6": 0.045,
